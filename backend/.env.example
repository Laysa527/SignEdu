# Copie este arquivo para .env e preencha com os dados do seu MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_a_senha_do_mysql_aqui
DB_NAME=signedu
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria_longa
# Opcionais (em produção use FLASK_DEBUG=0 e COOKIE_SECURE=1 com HTTPS)
HOST=127.0.0.1
# Celular ou outro PC na mesma rede: um segundo endereço https nesta porta (vazio = desligado)
PORTA_REDE=
HTTPS=0
PORT=5000
FLASK_DEBUG=0
COOKIE_SECURE=0
